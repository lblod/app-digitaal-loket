ref:7eabc047-9156-4ffc-a562-1ebda7e31777
  rdf:type ref:ReferencingRule ;
  mu:uuid "7eabc047-9156-4ffc-a562-1ebda7e31777" ;
  # Advies bij jaarrekening eredienstbestuur
  rdfs:domain BesluitType:79414af4-4f57-4ca3-aaa4-f8f1e015e71c ;
  # Jaarrekeningen van de besturen van de eredienst
  rdfs:range BesluitDocumentType:672bf096-dccd-40af-ab60-bd7de15cc461 ;
  lblodBesluit:decidableBy
    # Provincie
    BestuurseenheidClassificatieCode:5ab0e9b8a3b2ca7c5e000000 ,
    # Gemeente
    BestuurseenheidClassificatieCode:5ab0e9b8a3b2ca7c5e000001 ;
  lblodBesluit:referredDecidableBy
    ere:CentraalBestuurVanDeEredienst ,
    # Centraal bestuur van de eredienst
    BestuurseenheidClassificatieCode:f9cac08a-13c1-49da-9bcb-f650b0604054 .

