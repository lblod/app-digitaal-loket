PREFIX schema: <http://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>

INSERT {
  GRAPH ?g {
    ?form schema:publication <http://lblod.data.gift/concepts/403b71bd-5ab9-4c92-8990-4bb19d5469d1> .
  }
}
WHERE {
  VALUES ?submission {
    <http://data.lblod.info/submissions/0d9cd400-6f29-11f1-88b6-cd9975d68a5c>
  }
  ?submission prov:generated ?form .
  GRAPH ?g {
    ?form a ?formType .
  }
  FILTER(?g NOT IN (<http://redpencil.data.gift/id/deltas/producer/loket-submissions>))
  FILTER NOT EXISTS { ?form schema:publication <http://lblod.data.gift/concepts/403b71bd-5ab9-4c92-8990-4bb19d5469d1> . }
}